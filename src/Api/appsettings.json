{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ]
  },
  "Jwt": {
    "Secret": "P6JBDbJxWWFoYPBPIbXb4BP4Ag541RutrNci5NmT3qm",
    "Issuer": "App",
    "Audience": "App",
    "ExpirationInMinutes": "60",
    "RefreshTokenExpirationInDays": "7"
  }
}
